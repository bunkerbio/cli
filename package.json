{
  "name": "@boole/cli",
  "version": "0.4.4",
  "private": false,
  "description": "Command-line interface for Boole — run, pull, and serve local LLMs via llama.cpp. Companion CLI to the @boole/boole SDK, bundling the same edge-inference engine independently.",
  "license": "BSD-2-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/boole-ai/cli.git"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r --filter './packages/*' run test",
    "lint": "pnpm -r --filter './packages/*' run lint",
    "clean": "pnpm -r --filter './packages/*' exec rm -rf dist node_modules",
    "build:boole": "pnpm --filter @boole/boole run build",
    "build:cli": "pnpm --filter @boole/cli run build",
    "test:boole": "pnpm --filter @boole/boole run test",
    "test:cli": "pnpm --filter @boole/cli run test"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=8"
  },
  "keywords": [
    "monorepo",
    "llm",
    "inference",
    "local-first",
    "llama.cpp"
  ],
  "devDependencies": {
    "@types/react": "^19.2.18"
  }
}
